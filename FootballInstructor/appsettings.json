{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
    "AISettings": {
    "AIType": "ReinforcementLearning",
    "ModelPath": "./models/",
    "EnableTraining": true,
    "EnableLogging": true,
    "ExplorationRate": 0.1,
    "ImitationLearningEnabled": true,
    "ImitationEveryNSteps": 5,
    "ImitationWeight": 0.5
  }
}
