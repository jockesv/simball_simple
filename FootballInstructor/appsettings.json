{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
    "AISettings": {
    "AIType": "PPO",
    "ModelPath": "./models/",
    "EnableTraining": true,
    "EnableLogging": true,
    "ExplorationRate": 0.1,
    "ImitationLearningEnabled": true,
    "ImitationEveryNSteps": 5,
    "ImitationWeight": 0.5,
    "PPOGamma": 0.99,
    "PPOLambda": 0.95,
    "PPOClipEpsilon": 0.2,
    "PPOEpochs": 4,
    "PPOBatchSize": 64,
    "PPOBufferSize": 20
  }
}
